# Copy to .env for local development. Never commit a real .env.

# Leave unset locally to use zero-config SQLite (backend/parkwise.db).
# On Vercel set this to the Neon URL.
DATABASE_URL=

ENVIRONMENT=development
AUTO_SEED=true

# Signs admin JWTs. Generate your own.
JWT_SECRET=change-me

# Admin actions require this value in the X-Admin-Token header.
# Required when ENVIRONMENT=production.
ADMIN_TOKEN=

# Per-device ingest keys, format: device_id:key,device_id:key
# Generated per ESP32 / edge agent so one device can be revoked alone.
DEVICE_API_KEYS=
